<% content_for :title, "Agent Log — Kevin Skilton" %>

<section class="hero-panel">
  <div class="hero-main">
    <div class="hero-badges">
      <span class="badge badge-slate">Real agent definitions</span>
    </div>

    <p class="section-kicker">Agent workflow</p>
    <h1 class="hero-title">Not a summary — the actual files.</h1>
    <p class="hero-copy">This site's non-trivial changes go through a three-agent pipeline: a read-only locator investigates, an implementer builds from its handoff, and an independent validator reviews the diff. Below are the exact <code>.claude/agents/*.md</code> definitions that make that work, pulled live from this repo — not a description of them.</p>
  </div>
  <%= render "shared/built_with", technologies: [ "React 19", "esbuild", "Tailwind" ] %>
</section>

<section class="content-panel">
  <div class="content-stack">
    <p class="section-kicker">Locate → Implement → Validate</p>
    <h2 class="panel-title">rails-locator → scoped-implementer → diff-validator</h2>
  </div>

  <div id="agent-log-tabs">
    <noscript>
      <p class="panel-copy">JavaScript is disabled, so the tabbed viewer can't render. The raw files are readable directly in the repo under <code>.claude/agents/</code>.</p>
    </noscript>
  </div>

  <script type="application/json" id="agent-log-data"><%= raw(@agent_files.to_json) %></script>
</section>

<%= javascript_include_tag "agent_log", type: "module", defer: true %>
