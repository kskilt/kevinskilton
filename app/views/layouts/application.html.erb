<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kevinskilton" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kevinskilton">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "alternate", type: "application/rss+xml", title: "Kevin Skilton — Blog", href: blog_rss_path %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png?v=<%= icon_asset_version %>" type="image/png">
    <link rel="icon" href="/icon.svg?v=<%= icon_asset_version %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=<%= icon_asset_version %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-shell">
    <header class="site-header">
      <div class="site-header-inner">
        <%= link_to "Kevin Skilton", root_path, class: "site-brand" %>

        <nav class="site-nav">
          <%= link_to "Home", root_path %>
          <%= link_to "Blog", blog_path %>
          <%= link_to "About", about_path %>
          <%= link_to "Agent Log", agent_log_path %>
          <%= link_to "Code Example", demo_path %>
          <a href="https://github.com/kskilt" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <%= yield %>
    </main>
  </body>
</html>
