<% content_for :title, "#{@post.title} — Kevin Skilton" %>

<article>
  <p class="mb-6">
    <%= link_to "&larr; All posts".html_safe, posts_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </p>

  <h1 class="text-3xl font-bold mb-2"><%= @post.title %></h1>
  <p class="text-sm text-gray-500 mb-8">
    <%= @post.published_at.strftime("%B %-d, %Y") %>
    <% if @post.category.present? %>
      &middot; <%= @post.category %>
    <% end %>
  </p>

  <div class="rendered-body">
    <%= @post.rendered_body %>
  </div>
</article>
